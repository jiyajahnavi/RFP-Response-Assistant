# Application Settings
PROJECT_NAME="RFP Response Assistant"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

# Database Configuration
# MySQL:
DATABASE_URL="mysql+pymysql://root:@127.0.0.1:3306/rfp_assistant"

# SQL Server / Azure SQL via ODBC Driver 18:
# DATABASE_URL="mssql+pyodbc://username:password@server.database.windows.net:1433/database_name?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=no"

# Local SQLite fallback:
# DATABASE_URL="sqlite:///./rfp_assistant.db"

# Database Engine Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
